{
  "name": "to_do_app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "all": "mocha -r ts-node/register --reporter mocha-multi-reporters --reporter-options configFile=mocha-reporter-config.json tests/**/*.spec.ts",
    "home": "mocha -r ts-node/register --reporter mocha-multi-reporters --reporter-options configFile=mocha-reporter-config.json tests/01_home.spec.ts",
    "add_task": "mocha -r ts-node/register --reporter mocha-multi-reporters --reporter-options configFile=mocha-reporter-config.json tests/02_add_task.spec.ts",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "clean:allure": "rm -rf allure-results allure-report",
    "smoke": "mocha -r ts-node/register --grep @smoke --reporter mocha-multi-reporters --reporter-options configFile=mocha-reporter-config.json tests/**/*.spec.ts",
    "sanity": "mocha -r ts-node/register --grep @sanity --reporter mocha-multi-reporters --reporter-options configFile=mocha-reporter-config.json tests/**/*.spec.ts",
    "regression": "mocha -r ts-node/register --grep @regression --reporter mocha-multi-reporters --reporter-options configFile=mocha-reporter-config.json tests/**/*.spec.ts",
    "sanity_parallel": "mocha --parallel --jobs 2 -r ts-node/register --grep @sanity --reporter mocha-multi-reporters --reporter-options configFile=mocha-reporter-config.json tests/**/*.spec.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@types/mocha": "^10.0.10",
    "allure-commandline": "^2.36.0",
    "allure-mocha": "^3.4.5",
    "cross-env": "^10.1.0",
    "mocha": "^11.7.5",
    "mocha-multi-reporters": "^1.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "webdriverio": "^9.23.0"
  }
}